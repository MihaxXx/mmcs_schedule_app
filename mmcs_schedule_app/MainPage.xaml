<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:mmcs_schedule_app"
             x:Class="mmcs_schedule_app.MainPage"
             Title="Расписание">
    <StackLayout Spacing="10" Padding="10,10">
        <Picker Title="Тип расписания" x:Name="RolePicker" IsEnabled="False" VerticalOptions="Start" SelectedIndexChanged="RolePicker_SelectedIndexChanged" >
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Студент</x:String>
                    <x:String>Преподаватель</x:String>
                    <x:String>Аудитория</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <Picker Title="Курс / ФИО / Аудитория" IsEnabled="False" x:Name="OwnerPicker" VerticalOptions="Start" SelectedIndexChanged="OwnerPicker_SelectedIndexChanged">
            <Picker.ItemsSource>
            </Picker.ItemsSource>
        </Picker>
        <Picker Title="Группа" x:Name="GroupPicker" VerticalOptions="Start"
                SelectedIndexChanged="GroupPicker_SelectedIndexChanged"
                IsEnabled="False">
            <Picker.ItemsSource>
            </Picker.ItemsSource>
        </Picker>
        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"/>
        <local:StatusBanner x:Name="Banner" RetryClicked="Banner_RetryClicked"/>
        <Button Text="ОК" x:Name="OkButton" IsEnabled="False" Clicked="OkButton_Clicked"/>
    </StackLayout>
</ContentPage>