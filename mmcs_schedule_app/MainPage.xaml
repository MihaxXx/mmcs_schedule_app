<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:mmcs_schedule_app"
             x:Class="mmcs_schedule_app.MainPage"
             Title="Расписание">
    <StackLayout Spacing="10" Padding="10,10">
        <Picker Title="Студент / Преподаватель" x:Name="Role" IsEnabled="False" VerticalOptions="Start" SelectedIndexChanged="Role_SelectedIndexChanged" >
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Студент</x:String>
                    <x:String>Преподаватель</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
        <Picker Title="Курс / ФИО" IsEnabled="False" x:Name="List_NmOrGr" VerticalOptions="Start" SelectedIndexChanged="List_NmOrGr_SelectedIndexChanged">
            <Picker.ItemsSource>
            </Picker.ItemsSource>
        </Picker>
        <Picker Title="Группа" x:Name="List_Groups" VerticalOptions="Start"
                SelectedIndexChanged="List_Groups_SelectedIndexChanged"
                IsEnabled="False">
            <Picker.ItemsSource>
            </Picker.ItemsSource>
        </Picker>
        <ActivityIndicator x:Name="activityIndicator" IsRunning="False" IsVisible="False"/>
        <local:StatusBanner x:Name="Banner" RetryClicked="Banner_RetryClicked"/>
        <Button Text="ОК" x:Name="Ok_btn" IsEnabled="False" Clicked="Ok_btnClicked"/>
    </StackLayout>
</ContentPage>